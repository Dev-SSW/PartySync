# Local example
DB_USERNAME=raidsync_local
DB_PASSWORD=replace_with_your_local_password
DB_URL=jdbc:postgresql://localhost:5432/raidsync
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ISO-8601 durations. Account sessions: 7 days; group sessions: at most 12 hours.
ACCOUNT_SESSION_TTL=P7D
MEMBER_SESSION_TTL=PT12H
# Single-instance limits shared by registration and login (per 5-minute window).
AUTH_IP_ATTEMPTS=30
AUTH_LOGIN_ATTEMPTS=10
AUTH_RATE_WINDOW=PT5M

# Test example: disposable database; API tests delete its data.
TEST_DB_USERNAME=raidsync_test
TEST_DB_PASSWORD=replace_with_your_test_password
TEST_DB_URL=jdbc:postgresql://localhost:5432/raidsync_test
