# 로컬 개발 설정 예시
DB_USERNAME=raidsync_local
DB_PASSWORD=replace_with_your_local_password
DB_URL=jdbc:postgresql://localhost:5432/raidsync
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 선택: PWA 일정 알림. node deploy/generate-vapid.mjs 로 한 번 생성 후 동일한 키를 유지한다.
# 세 값을 모두 비워 두면 알림 기능만 비활성화된다. 개인 키는 커밋하지 않는다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ISO-8601 형식의 API 인증 수명과 로그인 유지 기간
ACCOUNT_SESSION_TTL=PT15M
REMEMBER_LOGIN_TTL=P30D
# 로컬 HTTP 개발에서만 false로 설정하며 운영은 Secure 쿠키를 사용한다.
AUTH_COOKIE_SECURE=false
MEMBER_SESSION_TTL=PT12H
# 단일 서버의 회원가입·로그인 요청 제한(5분 기준)
AUTH_IP_ATTEMPTS=30
AUTH_LOGIN_ATTEMPTS=10
AUTH_RATE_WINDOW=PT5M

# 테스트 전용 DB 예시: API 테스트가 데이터를 정리하므로 개발·운영 DB 사용 금지
TEST_DB_USERNAME=raidsync_test
TEST_DB_PASSWORD=replace_with_your_test_password
TEST_DB_URL=jdbc:postgresql://localhost:5432/raidsync_test
