# Separate from the developer's root .env. Never point these values at the local/test DB.
COMPOSE_PROJECT_NAME=partysync
SITE_ADDRESS=replace-with-your-real-domain
ACME_EMAIL=replace-with-your-email
HSTS_ENABLED=false
POSTGRES_DB=partysync_prod
APP_DB_USER=partysync_app
# Absolute paths on the Linux server; files contain only the password and are not committed.
POSTGRES_ADMIN_PASSWORD_FILE=/opt/partysync/shared/secrets/postgres-admin.txt
APP_DB_PASSWORD_FILE=/opt/partysync/shared/secrets/db-password.txt
BACKEND_IMAGE=ghcr.io/dev-ssw/partysync-backend
FRONTEND_IMAGE=ghcr.io/dev-ssw/partysync-web
IMAGE_TAG=replace-with-verified-40-character-commit-sha
# Same-domain frontend uses /api; normally no cross-origin access is needed.
CORS_ALLOWED_ORIGINS=
ACCOUNT_SESSION_TTL=PT15M
REMEMBER_LOGIN_TTL=P30D
MEMBER_SESSION_TTL=PT12H
AUTH_IP_ATTEMPTS=30
AUTH_LOGIN_ATTEMPTS=10
AUTH_RATE_WINDOW=PT5M
GROUP_CREATE_ATTEMPTS=10
GROUP_JOIN_ATTEMPTS=30
GROUP_RATE_WINDOW=PT1M
DB_POOL_SIZE=5
# Optional PWA schedule notifications: generate once with node deploy/generate-vapid.mjs.
# Store output in the private shared/.env.prod (chmod 600), never in Git or frontend assets.
# Set all three together; use mailto:your-real-contact@example.com for VAPID_SUBJECT.
# Keep keys stable across deployments. Changing keys requires users to enable notifications again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# If this subnet conflicts with an existing Docker network, change all four together.
PROXY_SUBNET=172.30.77.0/28
PROXY_IP=172.30.77.2
BACKEND_PROXY_IP=172.30.77.3
TRUSTED_PROXY_REGEX=172[.]30[.]77[.]2
