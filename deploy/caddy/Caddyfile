{
	email {$ACME_EMAIL}
	admin off
}

{$SITE_ADDRESS} {
	root * /srv
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}
	# Enable only AFTER the real public hostname has passed HTTPS checks.
	@hsts expression {$HSTS_ENABLED:false}
	header @hsts Strict-Transport-Security "max-age=31536000"

	request_body {
		max_size 256KB
	}
	# Access logging is intentionally disabled: /join contains invitation credentials.
	# Caddy runtime events still go to stdout; never enable request/header/body debug logs.
	@api path /api /api/*
	handle @api {
		reverse_proxy backend:8080 {
			header_up -Forwarded
			header_up X-Forwarded-Port {port}
			# Caddy's default overwrites untrusted X-Forwarded-* values.
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}
	handle /healthz {
		rewrite * /actuator/health
		reverse_proxy backend:8080 {
			header_up -Forwarded
			header_up X-Forwarded-Port {port}
		}
	}
	handle /actuator* {
		respond 404
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
}

# Only the proxy container's loopback interface can access this static file probe.
:2015 {
	bind 127.0.0.1
	root * /srv
	file_server
}
